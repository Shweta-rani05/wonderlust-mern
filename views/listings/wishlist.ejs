<% layout("/layouts/boilerplate") %>
<body>
    <style>
        .wishlist-card {
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
        }
        .wishlist-card.removing {
            opacity: 0;
            transform: scale(0.9);
            margin-right: -20px;
            pointer-events: none;
        }
        .empty-state {
            text-align: center;
            padding: 4rem 2rem;
            background: #f8f9fa;
            border-radius: 1.5rem;
            margin-top: 2rem;
        }
        .empty-state i {
            font-size: 4rem;
            color: #ff385c;
            margin-bottom: 1.5rem;
            opacity: 0.8;
        }
        .empty-state h3 {
            font-weight: 600;
            color: #222;
        }
        .empty-state p {
            color: #666;
            margin-bottom: 2rem;
        }
        .btn-explore {
            background-color: #ff385c;
            color: white;
            font-weight: 600;
            padding: 0.75rem 2.5rem;
            border-radius: 2rem;
            transition: background-color 0.2s ease;
            text-decoration: none;
            display: inline-block;
        }
        .btn-explore:hover {
            background-color: #e0314f;
            color: white;
        }
    </style>

    <div class="container mt-4">
        <h3 class="mb-4 fw-bold">Your Saved Listings</h3>

        <% if (wishlistedListings.length === 0) { %>
            <div class="empty-state shadow-sm">
                <i class="fa-regular fa-heart"></i>
                <h3>No saved listings yet</h3>
                <p>Explore properties and click the heart icon to save them to your wishlist.</p>
                <a href="/listings" class="btn-explore">Explore Listings</a>
            </div>
        <% } else { %>
            <div class="row row-cols-lg-3 row-cols-md-2 row-cols-sm-1 g-4" id="wishlist-grid">
                <% for (let listing of wishlistedListings) { %>
                    <div class="col wishlist-card-wrapper" id="card-<%= listing._id %>">
                        <a href="/listings/<%= listing._id %>" class="listing-link">
                            <div class="card col listing-card wishlist-card h-100">
                                <img src="<%= listing.image.url || 'https://images.unsplash.com/photo-1505693416388-ac5ce068fe85' %>"
                                    class="card-img-top" alt="listingsimage" style="height:20rem; object-fit: cover;" />
                                
                                <div class="card-img-overlay" style="pointer-events: none; background: none;">
                                    <button class="wishlist-btn border-0 bg-transparent" data-id="<%= listing._id %>" aria-label="Toggle Wishlist" style="position: absolute; top: 15px; right: 15px; z-index: 10; outline: none; pointer-events: auto;">
                                        <i class="fa-solid fa-heart" style="font-size: 1.5rem; color: #ff385c; text-shadow: 0 0 5px rgba(0,0,0,0.5); filter: drop-shadow(0px 1px 2px rgba(0,0,0,0.4));"></i>
                                    </button>
                                </div>

                                <div class="card-body">
                                    <p class="card-text">
                                        <b><%= listing.title %></b>
                                        <br />
                                        &#8377;<%= listing.price.toLocaleString("en-IN") %>/night
                                    </p>
                                </div>
                            </div>
                        </a>
                    </div>
                <% } %>
            </div>

            <div class="empty-state shadow-sm d-none" id="empty-placeholder">
                <i class="fa-regular fa-heart"></i>
                <h3>No saved listings yet</h3>
                <p>Explore properties and click the heart icon to save them to your wishlist.</p>
                <a href="/listings" class="btn-explore">Explore Listings</a>
            </div>
        <% } %>
    </div>

    <script>
        document.querySelectorAll(".wishlist-btn").forEach(btn => {
            btn.addEventListener("click", async (e) => {
                e.preventDefault();
                e.stopPropagation();

                const id = btn.getAttribute("data-id");
                try {
                    const response = await fetch(`/listings/${id}/wishlist`, {
                        method: "POST",
                        headers: {
                            "Content-Type": "application/json"
                        }
                    });

                    const data = await response.json();
                    if (data.success && !data.added) {
                        // Card removal with animation
                        const cardWrapper = document.getElementById(`card-${id}`);
                        if (cardWrapper) {
                            const card = cardWrapper.querySelector(".wishlist-card");
                            card.classList.add("removing");
                            
                            setTimeout(() => {
                                cardWrapper.remove();
                                
                                // Check if grid is empty
                                const grid = document.getElementById("wishlist-grid");
                                if (grid && grid.children.length === 0) {
                                    grid.remove();
                                    document.getElementById("empty-placeholder").classList.remove("d-none");
                                }
                            }, 400);
                        }
                    }
                } catch (err) {
                    console.error("Error untoggling wishlist:", err);
                }
            });
        });
    </script>
</body>
