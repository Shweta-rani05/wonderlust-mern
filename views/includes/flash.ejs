<% if(success && success.length){ %>
    <div class="alert alert-success alert-dismissible fate show col-6 offset-3 " role="alert">
   <%= success %>
     <button type="button" clas="btn-class" data-bs-dismiss="alert" aria-label="Close">   
     </button>
    </div>
<% }%>

<!-- for error -->
<% if(error && error.length){ %>
    <div class="alert alert-danger alert-dismissible fate show col-6 offset-3 " role="alert">
   <%= error %>
     <button type="button" clas="btn-class" data-bs-dismiss="alert" aria-label="Close">   
     </button>
    </div>
<% }%>
